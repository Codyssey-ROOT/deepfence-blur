BLUR_IMAGE=deepfence-blur-fastapi:latest

# Spring -> FastAPI 인증
BLUR_API_KEY=replace-with-long-random-secret

# FastAPI -> Spring 인증
INTERNAL_API_KEY=replace-with-another-long-random-secret

SPRING_BASE_URL=https://api.deepfence.site

AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=replace-with-spring-s3-bucket