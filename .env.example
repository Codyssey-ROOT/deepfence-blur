BLUR_IMAGE=deepfence-blur-fastapi:latest
# Default: replace recognized Korean/Latin/digit text; fallback to blur on failure.
TEXT_MODE=replace
OCR_MIN_SCORE=0.60
# Generate a long random value and pass this to Spring EC2; empty means no API key.
BLUR_API_KEY=
# Optional custom Korean font path inside container:
# TEXT_FONT_PATH=/usr/share/fonts/truetype/nanum/NanumGothic.ttf

# --- S3 presigned upload API (/blur/images/*) ---
# AWS credentials come from the EC2 IAM role (or standard AWS env vars locally). Never put keys here.
AWS_REGION=ap-northeast-2
S3_BUCKET=
CDN_BASE_URL=
PRESIGNED_EXPIRES_SECONDS=300
MAX_FILE_SIZE_BYTES=12582912
S3_KEY_PREFIX=images/blur
